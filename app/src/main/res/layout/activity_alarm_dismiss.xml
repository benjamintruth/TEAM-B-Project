<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="32dp">

    <!-- Current Time Display -->
    <TextView
        android:id="@+id/current_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7:30 AM"
        android:textSize="72sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/alarm_label_text"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Alarm Label -->
    <TextView
        android:id="@+id/alarm_label_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wake up"
        android:textSize="24sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/current_time_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/puzzle_container" />

    <!-- Placeholder for future puzzle integration -->
    <FrameLayout
        android:id="@+id/puzzle_container"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="48dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/alarm_label_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/button_container">

        <!-- Placeholder text for Phase 5+ puzzle implementation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Puzzle will appear here\n(Future enhancement)"
            android:textAlignment="center"
            android:textColor="?android:attr/textColorTertiary"
            android:textSize="14sp"
            android:alpha="0.5" />
    </FrameLayout>

    <!-- Button Container -->
    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Primary action: Capture now -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/capture_now_button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="Capture Dream Now"
            android:textSize="18sp"
            app:cornerRadius="16dp"
            android:layout_marginBottom="12dp" />

        <!-- Secondary action: Dismiss alarm only -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dismiss_only_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Dismiss Alarm"
            android:textSize="16sp"
            style="@style/Widget.Material3.Button.TextButton"
            app:cornerRadius="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
